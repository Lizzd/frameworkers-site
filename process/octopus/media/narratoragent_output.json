    "lines": [
      {
        "line_id": "ln_001",
        "segment_id": "seg_001",
        "text": "Welcome back to Strange Nature.",
        "pause_after_ms": 300
      },
      {
        "line_id": "ln_002",
        "segment_id": "seg_001",
        "text": "I'm your host, and today, the octopus.",
        "pause_after_ms": 500
      },
      {
        "line_id": "ln_003",
        "segment_id": "seg_002",
        "text": "An octopus has three hearts: two pump blood through the gills, and one drives it around the body.",
        "pause_after_ms": 500
      },
      {
        "line_id": "ln_004",
        "segment_id": "seg_003",
        "text": "That blood runs blue because it carries oxygen with copper instead of iron.",
        "pause_after_ms": 500
      },
      {
        "line_id": "ln_005",
        "segment_id": "seg_004",
        "text": "Of its roughly 500 million neurons, nearly two-thirds live not in its head, but in its arms.",
        "pause_after_ms": 500
      },
      {
        "line_id": "ln_006",
        "segment_id": "seg_005",
        "text": "Each arm tastes, touches, and partly decides on its own.",
        "pause_after_ms": 500
      },
      {
        "line_id": "ln_007",
        "segment_id": "seg_006",
        "text": "And here's the strangest part.",
        "pause_after_ms": 300
      },
      {
        "line_id": "ln_008",
        "segment_id": "seg_006",
        "text": "An octopus is functionally colorblind, yet it can match the color and texture of coral, sand, or stone in under a second using thousands of pigment cells in its skin called chromatophores.",
        "pause_after_ms": 500
      },
      {
        "line_id": "ln_009",
        "segment_id": "seg_007",
        "text": "Some scientists call it the closest thing we have to alien intelligence.",
        "pause_after_ms": 300
      },
      {
        "line_id": "ln_010",
        "segment_id": "seg_007",
        "text": "Maybe intelligence doesn't need a spine at all.",
        "pause_after_ms": 800
      }
    ],
