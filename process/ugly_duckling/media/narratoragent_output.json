    "speaker": "",
    "lines": [
      {
        "line_id": "ln_001",
        "segment_id": "seg_001",
        "text": "Deep in the green countryside, a giant egg finally cracked open.",
        "pause_after_ms": 400
      },
      {
        "line_id": "ln_002",
        "segment_id": "seg_001",
        "text": "Out tumbled a big, clumsy, grey duckling.",
        "pause_after_ms": 800
      },
      {
        "line_id": "ln_003",
        "segment_id": "seg_002",
        "text": "The other farm animals laughed at him.",
        "pause_after_ms": 400
      },
      {
        "line_id": "ln_004",
        "segment_id": "seg_002",
        "text": "They called him ugly and chased him away.",
        "pause_after_ms": 800
      },
      {
        "line_id": "ln_005",
        "segment_id": "seg_003",
        "text": "Feeling very lonely, the poor duckling ran away into the wild marsh.",
        "pause_after_ms": 800
      },
      {
        "line_id": "ln_006",
        "segment_id": "seg_004",
        "text": "Winter came with biting winds and deep, heavy snow.",
        "pause_after_ms": 400
      },
      {
        "line_id": "ln_007",
        "segment_id": "seg_004",
        "text": "The shivering duckling hid all alone under a frozen log.",
        "pause_after_ms": 1000
      },
      {
        "line_id": "ln_008",
        "segment_id": "seg_005",
        "text": "At last, the warm spring sun began to melt the ice.",
        "pause_after_ms": 800
      },
      {
        "line_id": "ln_009",
        "segment_id": "seg_006",
        "text": "He saw three beautiful, elegant white swans gliding gracefully across the pond.",
        "pause_after_ms": 800
      },
      {
        "line_id": "ln_010",
        "segment_id": "seg_007",
        "text": "The duckling swam toward them, bowing his head in sadness.",
        "pause_after_ms": 800
      },
      {
        "line_id": "ln_011",
        "segment_id": "seg_008",
        "text": "But in the clear water, he saw his own reflection.",
        "pause_after_ms": 400
      },
      {
        "line_id": "ln_012",
        "segment_id": "seg_008",
        "text": "He was no longer a clumsy, dark grey bird.",
        "pause_after_ms": 800
      },
      {
        "line_id": "ln_013",
        "segment_id": "seg_009",
        "text": "He had grown into a beautiful, magnificent white swan!",
        "pause_after_ms": 400
      },
      {
        "line_id": "ln_014",
        "segment_id": "seg_009",
        "text": "With a joyful heart, he flapped his strong wings and flew into the bright blue sky.",
        "pause_after_ms": 0
      }
    ],
